{
  "name": "program-c-offline-assets",
  "version": "0.1.0",
  "offlineReady": true,
  "externalNetworkRequired": false,
  "runtimeEntrypoints": [
    "src/content/index.ts",
    "src/audio/index.ts"
  ],
  "requiredFiles": [
    "data/black_box_lines.json",
    "data/buyer_negotiation_scripts.json",
    "data/buyers.json",
    "data/card_templates.json",
    "data/daily_monologues.json",
    "data/data_cleaning_icons.json",
    "data/day_challenges.json",
    "data/news_templates.json",
    "data/package_recipes.json",
    "data/profile_puzzles.json",
    "data/protocol_scan_templates.json",
    "data/protocol_terms.json",
    "data/public_opinion_scripts.json",
    "data/users.json",
    "data/variables.json",
    "dist/content-manifest.json"
  ],
  "audio": {
    "mode": "web-audio-procedural",
    "externalFiles": [],
    "events": [
      "dataFlowIn",
      "cardGenerated",
      "cardMovedToSlot",
      "packageCreated",
      "packageSealed",
      "neonCharged",
      "wasteCreated",
      "transactionSuccess",
      "transactionSealed",
      "riskChanged",
      "newsGenerated",
      "newsBroadcast",
      "newsTicker",
      "publicOpinionPulse",
      "emotionSelected",
      "emotionEmpathySelected",
      "emotionAngerSelected",
      "emotionNumbnessSelected",
      "challengeSuccess",
      "challengeFail",
      "blackBoxLine",
      "challengeBgm",
      "monologueType",
      "bgmBlackBox",
      "bgmPressure",
      "bgmSilence",
      "conscienceChanged",
      "endingTriggered"
    ]
  },
  "notes": [
    "Program C does not require remote API calls for core gameplay decisions.",
    "Audio is generated by Web Audio API, so no audio asset download is required."
  ]
}
